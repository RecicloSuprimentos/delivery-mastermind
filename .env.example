# Variáveis de ambiente — copie este arquivo para .env e preencha os valores

# URL do Supabase (produção)
VITE_SUPABASE_URL=https://supabase.mgbase.com.br

# Chave pública anon do Supabase (não é segredo, é usada no frontend)
VITE_SUPABASE_PUBLISHABLE_KEY=

# ID do projeto Supabase
VITE_SUPABASE_PROJECT_ID=
