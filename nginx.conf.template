server {
    listen 80;
    server_name _;

    # Diretório onde o Vite/React joga o build (stage 2 do Dockerfile)
    root /usr/share/nginx/html;
    index index.html;

    # Habilita compressão gzip para performance
    gzip on;
    gzip_vary on;
    gzip_min_length 10240;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml application/javascript;
    gzip_disable "MSIE [1-6]\.";

    # Rota raiz da SPA (React Router fallback)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # =========================================================================
    # [LLM CONTEXT] REGRAS DE PROXY REVERSO (BYPASS DE CORS)
    # Estas regras espelham o que foi feito no vite.config.ts para dev local.
    # Em produção, chamadas da aplicação Web para /rest, /auth, etc. batem aqui
    # e o Nginx as repassa para a VPS do Supabase de forma server-to-server.
    # =========================================================================

    location /rest/ {
        proxy_pass https://supabase.mgbase.com.br/rest/;
        proxy_set_header Host supabase.mgbase.com.br;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /auth/ {
        proxy_pass https://supabase.mgbase.com.br/auth/;
        proxy_set_header Host supabase.mgbase.com.br;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /storage/ {
        proxy_pass https://supabase.mgbase.com.br/storage/;
        proxy_set_header Host supabase.mgbase.com.br;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Realtime usa WebSockets, precisa das tags Upgrade e Connection
    location /realtime/ {
        proxy_pass https://supabase.mgbase.com.br/realtime/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host supabase.mgbase.com.br;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400; # Impede fechamento por inatividade em websockets longos
    }

    # =========================================================================
    # WORKAROUND PARA O KONG DO SUPABASE (BUG DO WEBSOCKET 404 E TENANT)
    # O Kong em algumas versões self-hosted engole o path do WebSocket
    # e injeta o host "realtime" indevidamente, quebrando o Tenant.
    # =========================================================================
    location /realtime/v1/websocket {
        # O $args mantém os parâmetros originais (apikey, vsn, etc)
        proxy_pass https://supabase.mgbase.com.br/realtime/v1/socket/websocket?tenant=supabase.mgbase.com.br&$args;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        # MÁGICA: Bypassa o erro "403 Forbidden" (check_origin)
        proxy_set_header Host supabase.mgbase.com.br;
        proxy_set_header Origin "https://supabase.mgbase.com.br";
        
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }

    location /functions/ {
        proxy_pass https://supabase.mgbase.com.br/functions/;
        proxy_set_header Host supabase.mgbase.com.br;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # =========================================================================
    # WEBHOOK DO CRM (SEM SENHA)
    # Rota obscura para receber o webhook e injetar as chaves seguras do Supabase
    # =========================================================================
    location /webhook/crm-integration-d9f2a7 {
        # Resolver interno do Docker para resolução dinâmica (evita crash se o container subir depois)
        resolver 127.0.0.11 valid=10s;
        set $crm_backend http://crm-receiver:3001;
        
        # Redireciona para o micro-serviço Node.js standalone (crm-receiver)
        proxy_pass $crm_backend$uri;

        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Content-Type "application/json";
        
        # O micro-serviço Node já envia os headers CORS. Removendo do Nginx para evitar duplicidade (*, *).
    }
}
# Force trigger deploy
